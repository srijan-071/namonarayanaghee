  "content": "\n      <section id=\"shopify-section-template--21006359265448__social\" class=\"shopify-section nn-social-section\">\n\n<section class=\"nn-social\" id=\"nn-social-template--21006359265448__social\"><div class=\"nn-social__container\"><div class=\"nn-social__logo-wrap\">\n        <div class=\"nn-social__logo-ring\">\n          <img src=\"/media/Namo_Narayana_Officail_Logo_df30ed.png\" alt=\"Namo Narayana\" class=\"nn-social__logo\" width=\"120\" height=\"120\" loading=\"eager\">\n        </div>\n      </div><div class=\"nn-social__header nn-social__header--center\"><p class=\"nn-social__eyebrow\">\n          <span class=\"nn-social__eyebrow-line\"></span>\n          Stay Connected\n          <span class=\"nn-social__eyebrow-line\"></span>\n        </p><h1 class=\"nn-social__heading\">Follow Namo Narayana</h1><p class=\"nn-social__subheading\">Join our community for updates, offers and behind-the-scenes content</p></div><div class=\"nn-social__grid\"><a href=\"https://www.instagram.com/namonarayanaofficial?igsh=eDgxdWlvajJ4NnVy\" class=\"nn-social__card\" target=\"_blank\" rel=\"noopener noreferrer\" aria-label=\"Instagram\" data-platform=\"instagram\">\n            <span class=\"nn-social__icon-wrap nn-social__icon-wrap--custom\"><img src=\"/media/insta_a12f43.png\" alt=\"\" class=\"nn-social__icon nn-social__icon--custom\" width=\"52\" height=\"52\" loading=\"lazy\"></span>\n\n            <span class=\"nn-social__text\">\n              <span class=\"nn-social__label\">Instagram</span></span>\n\n            <span class=\"nn-social__arrow\" aria-hidden=\"true\">\n              <svg viewBox=\"0 0 24 24\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n                <path d=\"M9 6l6 6-6 6\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path>\n              </svg>\n            </span>\n          </a><a href=\"https://www.facebook.com/share/18hvKbVSpg/\" class=\"nn-social__card\" target=\"_blank\" rel=\"noopener noreferrer\" aria-label=\"Facebook\" data-platform=\"facebook\">\n            <span class=\"nn-social__icon-wrap nn-social__icon-wrap--custom\"><img src=\"/media/fb_d1f570.png\" alt=\"\" class=\"nn-social__icon nn-social__icon--custom\" width=\"52\" height=\"52\" loading=\"lazy\"></span>\n\n            <span class=\"nn-social__text\">\n              <span class=\"nn-social__label\">Facebook</span></span>\n\n            <span class=\"nn-social__arrow\" aria-hidden=\"true\">\n              <svg viewBox=\"0 0 24 24\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n                <path d=\"M9 6l6 6-6 6\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path>\n              </svg>\n            </span>\n          </a><a href=\"https://youtube.com/@namonarayanaofficial?si=nJeKiiTTczsHWFnd\" class=\"nn-social__card\" target=\"_blank\" rel=\"noopener noreferrer\" aria-label=\"Youtube\" data-platform=\"youtube\">\n            <span class=\"nn-social__icon-wrap nn-social__icon-wrap--custom\"><img src=\"/media/yt_5550e5.png\" alt=\"\" class=\"nn-social__icon nn-social__icon--custom\" width=\"52\" height=\"52\" loading=\"lazy\"></span>\n\n            <span class=\"nn-social__text\">\n              <span class=\"nn-social__label\">Youtube</span></span>\n\n            <span class=\"nn-social__arrow\" aria-hidden=\"true\">\n              <svg viewBox=\"0 0 24 24\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n                <path d=\"M9 6l6 6-6 6\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path>\n              </svg>\n            </span>\n          </a><a href=\"https://x.com/thenamonarayana\" class=\"nn-social__card\" target=\"_blank\" rel=\"noopener noreferrer\" aria-label=\"X (Twitter)\" data-platform=\"x\">\n            <span class=\"nn-social__icon-wrap nn-social__icon-wrap--custom\"><img src=\"/media/x_logo_378450.png\" alt=\"\" class=\"nn-social__icon nn-social__icon--custom\" width=\"52\" height=\"52\" loading=\"lazy\"></span>\n\n            <span class=\"nn-social__text\">\n              <span class=\"nn-social__label\">X (Twitter)</span></span>\n\n            <span class=\"nn-social__arrow\" aria-hidden=\"true\">\n              <svg viewBox=\"0 0 24 24\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n                <path d=\"M9 6l6 6-6 6\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path>\n              </svg>\n            </span>\n          </a></div></div>\n</section>\n\n<style>\n  @font-face {\n  font-family: Fraunces;\n  font-weight: 700;\n  font-style: normal;\n  font-display: swap;\n  src: url(\"/media/fraunces_n7.8276f3981cfafc8569d516ceaa7dfe6a18948a1f_4f42ae.woff2\") format(\"woff2\"),\n       url(\"/media/fraunces_n7.383b2f958615709ba42e3731be308ad164ca4edd_31bd01.woff\") format(\"woff\");\n}\n\n  @font-face {\n  font-family: Figtree;\n  font-weight: 400;\n  font-style: normal;\n  font-display: swap;\n  src: url(\"/media/figtree_n4.3c0838aba1701047e60be6a99a1b0a40ce9b8419_d1688a.woff2\") format(\"woff2\"),\n       url(\"/media/figtree_n4.c0575d1db21fc3821f17fd6617d3dee552312137_ba42d5.woff\") format(\"woff\");\n}\n\n\n  .nn-social {\n    --nn-primary: #00584B;\n    --nn-primary-dark: #003F36;\n    --nn-green-tint: #EAF1ED;\n    --nn-bg-warm: #FBF7EF;\n    --nn-text: #242424;\n    --nn-text-light: #5C6B65;\n    --nn-hairline: #E7E1D5;\n    --nn-social-heading-color: #242424;\n    --nn-social-subheading-color: #5C6B65;\n    --nn-social-eyebrow-color: #00584B;\n    --nn-social-container: 620px;\n    --nn-social-heading-size: 44px;\n    position: relative;\n    isolation: isolate;\n    min-height: 100vh;\n    overflow: hidden;\n    background: #f9f6ef;\n    padding: 60px 0 60px;\n    margin: 0px 0 0px;\n    font-family: Figtree, sans-serif;\n    display: flex;\n    align-items: center;\n  }\n\n  /* Real <img> background — renders SVG-with-embedded-images on iOS/mobile (CSS background-image does not) + overlay */.nn-social__container {\n    position: relative;\n    z-index: 1;\n    max-width: var(--nn-social-container, 620px);\n    margin: 0 auto;\n    padding: 0 24px;\n    width: 100%;\n  }\n\n  /* Logo */\n  .nn-social__logo-wrap {\n    display: flex;\n    justify-content: center;\n    margin-bottom: 26px;\n  }\n  .nn-social__logo-ring {\n    width: 116px;\n    height: 116px;\n    border-radius: 50%;\n    padding: 5px;\n    background: #FFFFFF;\n    border: 1px solid var(--nn-hairline);\n    box-shadow: 0 1px 3px rgba(36,36,36,.06);\n  }\n  .nn-social__logo {\n    width: 100%;\n    height: 100%;\n    border-radius: 50%;\n    object-fit: cover;\n    display: block;\n    background: #fff;\n  }\n\n  /* Header */\n  .nn-social__header {\n    text-align: center;\n    margin-bottom: 40px;\n  }\n  .nn-social__header--left   { text-align: left; }\n  .nn-social__header--center { text-align: center; }\n  .nn-social__header--right  { text-align: right; }\n  .nn-social__header--left   .nn-social__eyebrow { justify-content: flex-start; }\n  .nn-social__header--right  .nn-social__eyebrow { justify-content: flex-end; }\n  .nn-social__header--left   .nn-social__subheading { margin-inline: 0; }\n  .nn-social__header--right  .nn-social__subheading { margin-left: auto; margin-right: 0; }\n  .nn-social__eyebrow {\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    gap: 10px;\n    font-size: 11px;\n    font-weight: 700;\n    letter-spacing: .18em;\n    text-transform: uppercase;\n    color: var(--nn-social-eyebrow-color, #00584B);\n    margin: 0 0 14px;\n  }\n  .nn-social__eyebrow-line {\n    width: 28px;\n    height: 1px;\n    background: var(--nn-hairline);\n  }\n\n  .nn-social__heading {\n    font-family: Fraunces, serif;\n    font-size: clamp(30px, 5vw, var(--nn-social-heading-size, 44px));\n    font-weight: 700;\n    color: var(--nn-social-heading-color, #242424);\n    margin: 0 0 12px;\n    line-height: 1.18;\n    letter-spacing: -.01em;\n  }\n  .nn-social__subheading {\n    font-size: 15px;\n    line-height: 1.6;\n    color: var(--nn-social-subheading-color, #5C6B65);\n    margin: 0;\n    max-width: 440px;\n    margin-inline: auto;\n  }\n\n  /* Cards */\n  .nn-social__grid {\n    display: flex;\n    flex-direction: column;\n    gap: 14px;\n  }\n\n  .nn-social__card {\n    position: relative;\n    display: flex;\n    align-items: center;\n    gap: 16px;\n    padding: 18px 22px;\n    background: #FFFFFF;\n    border-radius: 12px;\n    border: 1px solid var(--nn-hairline);\n    text-decoration: none;\n    box-shadow: 0 1px 3px rgba(36,36,36,.06);\n    transition: transform .25s ease, box-shadow .25s ease, border-color .25s ease;\n  }\n  .nn-social__card:hover {\n    transform: translateY(-3px);\n    box-shadow: 0 8px 22px rgba(36,36,36,.10);\n    border-color: var(--nn-primary);\n  }\n  .nn-social__card:active { transform: translateY(-1px); }\n\n  .nn-social__icon-wrap {\n    flex-shrink: 0;\n    width: 48px;\n    height: 48px;\n    border-radius: 12px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    background: var(--nn-primary);\n    color: #fff;\n    transition: background .25s ease;\n  }\n  .nn-social__card:hover .nn-social__icon-wrap {\n    background: var(--nn-primary-dark);\n  }\n  /* Custom uploaded icons — no colored box, just the image, same size for all */\n  .nn-social__icon-wrap--custom {\n    background: none;\n    box-shadow: none;\n    width: 52px;\n    height: 52px;\n  }\n  .nn-social__card:hover .nn-social__icon-wrap--custom {\n    background: none;\n  }\n  .nn-social__icon { width: 22px; height: 22px; }\n  .nn-social__icon--custom {\n    width: 52px;\n    height: 52px;\n    object-fit: contain;\n  }\n\n  .nn-social__text {\n    flex: 1;\n    min-width: 0;\n    display: flex;\n    flex-direction: column;\n    justify-content: center;\n    gap: 3px;\n  }\n  .nn-social__label {\n    font-size: 19px;\n    font-weight: 700;\n    color: var(--nn-text);\n  }\n  .nn-social__handle {\n    font-size: 13px;\n    color: var(--nn-text-light);\n  }\n\n  .nn-social__arrow {\n    flex-shrink: 0;\n    color: var(--nn-text-light);\n    opacity: 0;\n    transform: translateX(-6px);\n    transition: opacity .3s ease, transform .3s ease, color .3s ease;\n  }\n  .nn-social__arrow svg { width: 18px; height: 18px; }\n  .nn-social__card:hover .nn-social__arrow {\n    opacity: 1;\n    transform: translateX(0);\n    color: var(--nn-primary);\n  }\n\n  /* Scroll reveal */\n  @media (prefers-reduced-motion: no-preference) {\n    .nn-social__card {\n      opacity: 0;\n      transform: translateY(18px);\n      animation: nn-social-fade-in .6s cubic-bezier(.22,1,.36,1) forwards;\n    }\n    .nn-social__card:nth-child(1) { animation-delay: .05s; }\n    .nn-social__card:nth-child(2) { animation-delay: .12s; }\n    .nn-social__card:nth-child(3) { animation-delay: .19s; }\n    .nn-social__card:nth-child(4) { animation-delay: .26s; }\n    .nn-social__card:nth-child(5) { animation-delay: .33s; }\n    .nn-social__card:nth-child(6) { animation-delay: .4s; }\n    @keyframes nn-social-fade-in {\n      to { opacity: 1; transform: translateY(0); }\n    }\n  }\n\n  .nn-social__footer-text {\n    text-align: center;\n    margin: 36px 0 0;\n    font-size: 13px;\n    color: var(--nn-text-light);\n  }\n\n  @media (max-width: 480px) {\n    .nn-social { padding: 56px 0; }\n    .nn-social__card { padding: 15px 16px; gap: 13px; }\n    .nn-social__icon-wrap { width: 42px; height: 42px; border-radius: 12px; }\n    .nn-social__icon-wrap--custom { width: 42px; height: 42px; }\n    .nn-social__icon { width: 19px; height: 19px; }\n    .nn-social__icon--custom { width: 42px; height: 42px; }\n    .nn-social__label { font-size: 16px; }\n  }\n</style>\n\n\n</section>\n    "
}