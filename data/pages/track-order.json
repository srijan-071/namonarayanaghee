{
  "handle": "track-order",
  "seo": {
    "title": "Track Order\n – Namo Narayana",
    "description": "Namo Narayana",
    "ogImage": ""
  },
  "content": "\n      <section id=\"shopify-section-template--21161880158376__track-order\" class=\"shopify-section nn-track-section\">\n\n<div class=\"nn-ds-section nn-ds-section--cream nn-track\">\n  <div class=\"nn-ds-container\">\n    <div class=\"nn-track__card nn-ds-card\" id=\"nn-track-form\">\n      <div class=\"nn-track__card-inner\">\n        <h1 class=\"nn-ds-title\" style=\"text-align:center;\">Track Your Order</h1>\n        <p class=\"nn-ds-sub\" style=\"text-align:center;margin-top:8px;\">\n          Enter your Order ID or AWB number to check shipment status.\n        </p>\n\n        <div class=\"nn-track__toggle\">\n          <label class=\"nn-track__radio is-active\" data-mode=\"order_id\">\n            <input type=\"radio\" name=\"trackMode\" value=\"order_id\" checked=\"\">\n            <span>Order ID</span>\n          </label>\n          <label class=\"nn-track__radio\" data-mode=\"awb\">\n            <input type=\"radio\" name=\"trackMode\" value=\"awb\">\n            <span>Tracking ID / AWB</span>\n          </label>\n        </div>\n\n        <div class=\"nn-track__search\">\n          <input type=\"text\" id=\"nn-track-input\" class=\"nn-track__input\" placeholder=\"Enter your Order ID\" autocomplete=\"off\">\n          <button class=\"nn-ds-btn nn-ds-btn--primary nn-track__btn\" id=\"nn-track-btn\">\n            <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"11\" cy=\"11\" r=\"8\"></circle><line x1=\"21\" y1=\"21\" x2=\"16.65\" y2=\"16.65\"></line></svg>\n            Track\n          </button>\n        </div>\n\n        <p class=\"nn-track__msg\" id=\"nn-track-msg\"></p>\n      </div>\n    </div>\n    <div class=\"nn-track__result\" id=\"nn-track-result\" style=\"display:none;\">\n      <button class=\"nn-track__back\" id=\"nn-track-back\">\n        <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><line x1=\"19\" y1=\"12\" x2=\"5\" y2=\"12\"></line><polyline points=\"12 19 5 12 12 5\"></polyline></svg>\n        Track Another Order\n      </button>\n      <div class=\"nn-track__status-card nn-ds-card\" id=\"nn-track-status\"></div>\n      <div class=\"nn-track__timeline-card nn-ds-card\" id=\"nn-track-timeline\"></div>\n      <div class=\"nn-track__activity-card nn-ds-card\" id=\"nn-track-activity\">\n        <button class=\"nn-track__activity-toggle\" id=\"nn-track-activity-toggle\">\n          <span>Shipment Activity</span>\n          <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><polyline points=\"6 9 12 15 18 9\"></polyline></svg>\n        </button>\n        <div class=\"nn-track__activity-list\" id=\"nn-track-activity-list\" style=\"display:none;\"></div>\n      </div>\n    </div>\n\n  </div>\n</div>\n\n<style>\n  /* ── Track Section ── */\n  .nn-track { min-height: 60vh; display:flex; align-items:flex-start; }\n\n  .nn-track__card { max-width:600px; margin:0 auto; overflow:hidden; }\n  .nn-track__card-inner { padding: clamp(24px,4vw,40px); }\n\n  /* Toggle */\n  .nn-track__toggle { display:flex; gap:8px; justify-content:center; margin:24px 0 20px; }\n  .nn-track__radio { display:flex; align-items:center; gap:6px; padding:8px 16px; border-radius:var(--nn-radius-sm); border:1.5px solid var(--nn-hairline); cursor:pointer; font-family:var(--nn-font-body); font-size:.875rem; font-weight:600; color:var(--nn-bark); transition:all .2s ease; }\n  .nn-track__radio:hover { border-color:var(--nn-leaf); }\n  .nn-track__radio.is-active { background:var(--nn-leaf); color:#fff; border-color:var(--nn-leaf); }\n  .nn-track__radio input { display:none; }\n\n  /* Search */\n  .nn-track__search { display:flex; gap:8px; }\n  .nn-track__input { flex:1; font-family:var(--nn-font-body); font-size:1rem; padding:12px 16px; border:1.5px solid var(--nn-hairline); border-radius:var(--nn-radius-sm); background:var(--nn-white); color:var(--nn-ink); outline:none; transition:border-color .2s; }\n  .nn-track__input:focus { border-color:var(--nn-leaf); }\n  .nn-track__btn { white-space:nowrap; }\n  .nn-track__msg { font-family:var(--nn-font-body); font-size:.875rem; margin-top:12px; text-align:center; min-height:20px; }\n  .nn-track__msg--error { color:#c0392b; }\n  .nn-track__msg--loading { color:var(--nn-bark); }\n\n  /* Loader */\n  .nn-track__loader { display:inline-block; width:18px; height:18px; border:2.5px solid var(--nn-hairline); border-top-color:var(--nn-leaf); border-radius:50%; animation:nn-spin .6s linear infinite; vertical-align:middle; margin-right:6px; }\n  @keyframes nn-spin { to { transform:rotate(360deg); } }\n\n  /* Back */\n  .nn-track__back { display:inline-flex; align-items:center; gap:6px; font-family:var(--nn-font-body); font-size:.875rem; font-weight:600; color:var(--nn-leaf); background:none; border:none; cursor:pointer; padding:0; margin-bottom:16px; }\n  .nn-track__back:hover { color:var(--nn-leaf-hover); }\n\n  /* Status card */\n  .nn-track__status-card { padding:clamp(20px,3vw,32px); margin-bottom:16px; }\n  .nn-track__status-top { display:flex; align-items:center; gap:12px; margin-bottom:16px; }\n  .nn-track__status-icon { width:48px; height:48px; border-radius:50%; display:flex; align-items:center; justify-content:center; flex-shrink:0; }\n  .nn-track__status-icon--green { background:#E8F5E9; color:#2E7D32; }\n  .nn-track__status-icon--blue { background:#E3F2FD; color:#1565C0; }\n  .nn-track__status-icon--orange { background:#FFF3E0; color:#E65100; }\n  .nn-track__status-label { font-family:var(--nn-font-head); font-size:clamp(1.25rem,1rem+1vw,1.5rem); font-weight:600; color:var(--nn-ink); }\n  .nn-track__status-sub { font-family:var(--nn-font-body); font-size:.8125rem; color:var(--nn-bark); }\n  .nn-track__info-row { display:flex; flex-wrap:wrap; gap:12px 24px; padding-top:16px; border-top:1px solid var(--nn-hairline); }\n  .nn-track__info-item { font-family:var(--nn-font-body); font-size:.8125rem; }\n  .nn-track__info-item span:first-child { color:var(--nn-bark); }\n  .nn-track__info-item span:last-child { font-weight:600; color:var(--nn-ink); margin-left:4px; }\n\n  /* Timeline */\n  .nn-track__timeline-card { padding:clamp(20px,3vw,32px); margin-bottom:16px; }\n  .nn-track__steps { display:flex; justify-content:space-between; position:relative; }\n  .nn-track__steps::before { content:''; position:absolute; top:18px; left:24px; right:24px; height:3px; background:var(--nn-hairline); z-index:0; }\n  .nn-track__progress-bar { position:absolute; top:18px; left:24px; height:3px; background:var(--nn-leaf); z-index:1; transition:width .5s ease; }\n  .nn-track__step { display:flex; flex-direction:column; align-items:center; gap:8px; position:relative; z-index:2; flex:1; }\n  .nn-track__step-dot { width:36px; height:36px; border-radius:50%; border:3px solid var(--nn-hairline); background:var(--nn-white); display:flex; align-items:center; justify-content:center; transition:all .3s ease; }\n  .nn-track__step.is-done .nn-track__step-dot { background:var(--nn-leaf); border-color:var(--nn-leaf); }\n  .nn-track__step.is-current .nn-track__step-dot { border-color:var(--nn-leaf); background:var(--nn-white); box-shadow:0 0 0 4px rgba(35,90,73,.15); }\n  .nn-track__step-label { font-family:var(--nn-font-body); font-size:.7rem; font-weight:600; color:var(--nn-bark); text-align:center; max-width:72px; line-height:1.3; }\n  .nn-track__step.is-done .nn-track__step-label,\n  .nn-track__step.is-current .nn-track__step-label { color:var(--nn-ink); }\n  .nn-track__step-date { font-family:var(--nn-font-body); font-size:.65rem; color:var(--nn-bark); text-align:center; }\n\n  /* Activity */\n  .nn-track__activity-card { overflow:hidden; }\n  .nn-track__activity-toggle { width:100%; display:flex; align-items:center; justify-content:space-between; padding:16px clamp(20px,3vw,32px); background:none; border:none; cursor:pointer; font-family:var(--nn-font-body); font-size:.9375rem; font-weight:700; color:var(--nn-ink); }\n  .nn-track__activity-toggle svg { transition:transform .2s; }\n  .nn-track__activity-toggle.is-open svg { transform:rotate(180deg); }\n  .nn-track__activity-list { padding:0 clamp(20px,3vw,32px) 20px; }\n  .nn-track__activity-item { display:flex; gap:12px; padding:10px 0; border-bottom:1px solid var(--nn-hairline); }\n  .nn-track__activity-item:last-child { border-bottom:none; }\n  .nn-track__activity-dot { width:8px; height:8px; border-radius:50%; background:var(--nn-leaf); margin-top:6px; flex-shrink:0; }\n  .nn-track__activity-text { font-family:var(--nn-font-body); font-size:.8125rem; color:var(--nn-ink); line-height:1.5; }\n  .nn-track__activity-meta { font-size:.75rem; color:var(--nn-bark); margin-top:2px; }\n\n  /* Result area */\n  .nn-track__result { max-width:600px; margin:0 auto; }\n\n  @media(max-width:600px){\n    .nn-track__search { flex-direction:column; }\n    .nn-track__toggle { flex-direction:column; align-items:stretch; }\n    .nn-track__step-label { font-size:.6rem; max-width:56px; }\n    .nn-track__step-dot { width:28px; height:28px; }\n    .nn-track__steps::before { top:14px; left:16px; right:16px; }\n    .nn-track__progress-bar { top:14px; left:16px; }\n    .nn-track__info-row { flex-direction:column; gap:8px; }\n  }\n</style>\n\n<script>\n  (function(){\n    const API = 'https://nn-tracking-api.vercel.app';\n    const form = document.getElementById('nn-track-form');\n    const result = document.getElementById('nn-track-result');\n    const input = document.getElementById('nn-track-input');\n    const btn = document.getElementById('nn-track-btn');\n    const msg = document.getElementById('nn-track-msg');\n    const statusEl = document.getElementById('nn-track-status');\n    const timelineEl = document.getElementById('nn-track-timeline');\n    const activityList = document.getElementById('nn-track-activity-list');\n    const activityToggle = document.getElementById('nn-track-activity-toggle');\n    const backBtn = document.getElementById('nn-track-back');\n\n    let mode = 'order_id';\n\n    document.querySelectorAll('.nn-track__radio').forEach(function(label){\n      label.addEventListener('click', function(){\n        document.querySelectorAll('.nn-track__radio').forEach(function(l){ l.classList.remove('is-active'); });\n        label.classList.add('is-active');\n        mode = label.dataset.mode;\n        input.placeholder = mode === 'order_id' ? 'Enter your Order ID' : 'Enter AWB / Tracking ID';\n        input.value = '';\n        msg.textContent = '';\n      });\n    });\n\n    input.addEventListener('keydown', function(e){ if(e.key === 'Enter') doTrack(); });\n    btn.addEventListener('click', doTrack);\n    backBtn.addEventListener('click', function(){\n      result.style.display = 'none';\n      form.style.display = '';\n      input.value = '';\n      msg.textContent = '';\n    });\n\n    activityToggle.addEventListener('click', function(){\n      var list = document.getElementById('nn-track-activity-list');\n      var isOpen = list.style.display !== 'none';\n      list.style.display = isOpen ? 'none' : '';\n      activityToggle.classList.toggle('is-open', !isOpen);\n    });\n\n    function doTrack(){\n      var val = input.value.trim();\n      if(!val){ msg.className = 'nn-track__msg nn-track__msg--error'; msg.textContent = 'Please enter a valid ID'; return; }\n\n      msg.className = 'nn-track__msg nn-track__msg--loading';\n      msg.innerHTML = '<span class=\"nn-track__loader\"></span> Tracking your order...';\n      btn.disabled = true;\n\n      var url = API + '/api/track?' + (mode === 'order_id' ? 'order_id=' : 'awb=') + encodeURIComponent(val);\n\n      fetch(url)\n        .then(function(r){ return r.json().then(function(d){ return {ok: r.ok, data: d}; }); })\n        .then(function(res){\n          btn.disabled = false;\n          if(!res.ok || res.data.error){\n            msg.className = 'nn-track__msg nn-track__msg--error';\n            msg.textContent = res.data.status === 404 ? 'No tracking data found for this ID. Please check and try again.' : (res.data.error || 'Something went wrong');\n            return;\n          }\n          msg.textContent = '';\n          renderResult(res.data);\n        })\n        .catch(function(){\n          btn.disabled = false;\n          msg.className = 'nn-track__msg nn-track__msg--error';\n          msg.textContent = 'Network error. Please try again.';\n        });\n    }\n\n    var STEPS = [\n      {key: 'ordered',   label: 'Ordered',   codes: []},\n      {key: 'dispatched',label: 'Dispatched', codes: ['6','42','OP']},\n      {key: 'transit',   label: 'In Transit', codes: ['18','38','OT']},\n      {key: 'ofd',       label: 'Out for Delivery', codes: ['17','OO']},\n      {key: 'delivered', label: 'Delivered',  codes: ['7','DL']}\n    ];\n\n    function mapStatus(shipmentStatus){\n      if(shipmentStatus == 7) return 4;\n      if(shipmentStatus == 17) return 3;\n      if(shipmentStatus == 18 || shipmentStatus == 38) return 2;\n      if(shipmentStatus == 6 || shipmentStatus == 42) return 1;\n      if(shipmentStatus >= 1) return 0;\n      return 0;\n    }\n\n    function fmtDate(d){\n      if(!d) return '';\n      try {\n        var dt = new Date(d);\n        return dt.toLocaleDateString('en-IN',{day:'numeric',month:'short'}) + ', ' + dt.toLocaleTimeString('en-IN',{hour:'2-digit',minute:'2-digit',hour12:true});\n      } catch(e){ return d; }\n    }\n\n    function statusIcon(idx){\n      if(idx >= 4) return '<svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M22 11.08V12a10 10 0 1 1-5.93-9.14\"/><polyline points=\"22 4 12 14.01 9 11.01\"/></svg>';\n      return '<svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"12\" cy=\"12\" r=\"10\"/><polyline points=\"12 6 12 12 16 14\"/></svg>';\n    }\n\n    function renderResult(data){\n      var td = data.tracking_data || data;\n      var track = td.shipment_track ? td.shipment_track[0] : {};\n      var activities = td.shipment_track_activities || [];\n      var currentStep = mapStatus(td.shipment_status);\n      var isDelivered = td.shipment_status == 7;\n\n      var iconClass = isDelivered ? 'nn-track__status-icon--green' : 'nn-track__status-icon--blue';\n      var statusText = track.current_status || STEPS[currentStep].label;\n\n      statusEl.innerHTML =\n        '<div class=\"nn-track__status-top\">' +\n          '<div class=\"nn-track__status-icon ' + iconClass + '\">' + statusIcon(currentStep) + '</div>' +\n          '<div><div class=\"nn-track__status-label\">' + statusText + '</div>' +\n            (track.edd && !isDelivered ? '<div class=\"nn-track__status-sub\">Expected by ' + fmtDate(track.edd) + '</div>' : '') +\n            (isDelivered && track.delivered_date ? '<div class=\"nn-track__status-sub\">Delivered on ' + fmtDate(track.delivered_date) + '</div>' : '') +\n          '</div>' +\n        '</div>' +\n        '<div class=\"nn-track__info-row\">' +\n          (track.awb_code ? '<div class=\"nn-track__info-item\"><span>AWB:</span><span>' + track.awb_code + '</span></div>' : '') +\n          (track.order_id ? '<div class=\"nn-track__info-item\"><span>Order:</span><span>#' + track.order_id + '</span></div>' : '') +\n          (track.destination ? '<div class=\"nn-track__info-item\"><span>Destination:</span><span>' + track.destination + '</span></div>' : '') +\n        '</div>';\n\n      var stepDates = ['','','','',''];\n      activities.slice().reverse().forEach(function(a){\n        var code = a['sr-status'] || '';\n        STEPS.forEach(function(s, si){\n          if(s.codes.indexOf(code) > -1 && !stepDates[si]) stepDates[si] = a.date;\n        });\n      });\n      if(isDelivered && track.delivered_date) stepDates[4] = track.delivered_date;\n\n      var progressPct = isDelivered ? 100 : (currentStep === 0 ? 0 : (currentStep / (STEPS.length - 1)) * 100);\n\n      var stepsHtml = '<div class=\"nn-track__steps\"><div class=\"nn-track__progress-bar\" style=\"width:' + progressPct + '%\"></div>';\n      STEPS.forEach(function(s, i){\n        var cls = (i < currentStep || (i === currentStep && isDelivered)) ? 'is-done' : (i === currentStep ? 'is-current' : '');\n        var check = i <= currentStep ? '<svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"white\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><polyline points=\"20 6 9 17 4 12\"/></svg>' : '';\n        stepsHtml += '<div class=\"nn-track__step ' + cls + '\">' +\n          '<div class=\"nn-track__step-dot\">' + check + '</div>' +\n          '<div class=\"nn-track__step-label\">' + s.label + '</div>' +\n          (stepDates[i] ? '<div class=\"nn-track__step-date\">' + fmtDate(stepDates[i]) + '</div>' : '') +\n        '</div>';\n      });\n      stepsHtml += '</div>';\n      timelineEl.innerHTML = stepsHtml;\n\n      var actHtml = '';\n      activities.forEach(function(a){\n        actHtml += '<div class=\"nn-track__activity-item\">' +\n          '<div class=\"nn-track__activity-dot\"></div>' +\n          '<div><div class=\"nn-track__activity-text\">' + (a.activity || a.status || '') + '</div>' +\n          '<div class=\"nn-track__activity-meta\">' + fmtDate(a.date) + (a.location && a.location !== 'NA' ? ' &middot; ' + a.location : '') + '</div></div></div>';\n      });\n      activityList.innerHTML = actHtml || '<p style=\"padding:8px 0;color:var(--nn-bark);font-size:.8125rem;\">No activity details available.</p>';\n\n      form.style.display = 'none';\n      result.style.display = '';\n      activityToggle.classList.remove('is-open');\n      document.getElementById('nn-track-activity-list').style.display = 'none';\n    }\n\n    var params = new URLSearchParams(window.location.search);\n    if(params.get('order_id')){\n      input.value = params.get('order_id');\n      mode = 'order_id';\n      doTrack();\n    } else if(params.get('awb')){\n      input.value = params.get('awb');\n      mode = 'awb';\n      document.querySelectorAll('.nn-track__radio').forEach(function(l){\n        l.classList.toggle('is-active', l.dataset.mode === 'awb');\n      });\n      doTrack();\n    }\n  })();\n</script>\n\n\n</section>\n    "
}