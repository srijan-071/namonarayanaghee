rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Users can only read and write their own profile document
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Users can only read and create their own orders
    match /orders/{orderId} {
      allow create: if false; // Server only
      allow get: if true; // Allows success page to load via unguessable ID
      allow list: if request.auth != null && request.auth.uid == resource.data.userId;
      // Note: Updating or deleting orders is restricted. Admins should do this from backend/console.
      allow update, delete: if false; 
    }
    
    match /abandoned_carts/{email} {
      allow read, write: if true;
    }
    
    // Default deny for all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
