rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Users can only read and write their own profile document
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Users can only read and create their own orders
    match /orders/{orderId} {
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow read: if true;
      allow update: if true;
      allow delete: if false; 
    }
    
    match /abandoned_carts/{email} {
      allow read, write: if true;
    }
    
    // Promo emails for exit intent popup
    match /promo_emails/{emailId} {
      allow create: if true;
      allow read: if request.auth != null && request.auth.token.email == "littlecodr@gmail.com";
      allow update, delete: if false;
    }
    
    // Default deny for all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
